# Self-hosted Ciele configuration.
#
# You do not have to fill this in by hand: `./deploy/bootstrap.sh` writes a
# complete `deploy/.env` with every secret generated. This file documents what
# ends up there and what you may want to change afterwards.

# ── Which services run ───────────────────────────────────────────────────────
# The default stack. Add `workers` for the graph + crawler containers (heavy),
# `studio` for the database admin UI. Both are off unless listed here.
COMPOSE_PROFILES=db,migrate,app,cron

# ── Build from source, or run published images ───────────────────────────────
# Unset (the default), `app`, `migrate` and `cron` are built from the repo you
# checked out. Point COMPOSE_FILE at the overlay as well and they are pulled at
# the pinned release instead — no source build, minutes instead of an
# afternoon. `./deploy/bootstrap.sh --images vX.Y.Z` writes both lines for you.
#
#   COMPOSE_FILE=docker-compose.yml:docker-compose.images.yml
#   CIELE_IMAGE_TAG=v0.4.0
#
COMPOSE_FILE=
CIELE_IMAGE_TAG=
# Override only to run a mirror or your own rebuild of the three images.
CIELE_IMAGE_REGISTRY=

# ── Where it is reachable ────────────────────────────────────────────────────
# The app's own public origin (used for auth redirects and email links). With
# a reverse proxy in front, set this to the public HTTPS URL.
PUBLIC_URL=http://localhost:3000
# The Supabase gateway origin the BROWSER uses. Must be reachable from the
# user's machine, not just from inside Docker.
SUPABASE_PUBLIC_URL=http://localhost:8000
APP_PORT=3000
SUPABASE_PORT=8000
STUDIO_PORT=8080

# ── Generated secrets (bootstrap.sh fills these) ─────────────────────────────
# Postgres superuser password, also used by the Supabase service roles.
POSTGRES_PASSWORD=
# Signs every Supabase JWT. ANON_KEY and SERVICE_ROLE_KEY below are JWTs
# signed with it — regenerate all three together or auth breaks.
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
# Seals BYOK provider API keys at rest (AES-256-GCM).
APP_ENCRYPTION_KEY=
# Bearer token the cron container sends to the scheduled routes.
CRON_SECRET=

# ── Accounts ─────────────────────────────────────────────────────────────────
# The first account to sign up becomes the owner of its organization. Set this
# to also make that account the platform owner (cross-org settings).
PLATFORM_OWNER_EMAIL=
# Close signups once your team has accounts.
DISABLE_SIGNUP=false
# With no SMTP configured, signups are confirmed automatically so you can get
# in. Set SMTP_* below and flip this to false to require email confirmation.
MAILER_AUTOCONFIRM=true
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=

# ── AI providers ─────────────────────────────────────────────────────────────
# Any OpenAI-compatible server — Ollama, vLLM, LM Studio, a gateway — powers
# both chat and embeddings with no account anywhere. From inside Docker,
# reach a model server on the host as http://host.docker.internal:11434/v1.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_CHAT_MODEL=
# Without an embedding model, knowledge search falls back to lexical matching.
OPENAI_COMPATIBLE_EMBEDDING_MODEL=
OPENAI_COMPATIBLE_EMBEDDING_DIMS=
# Or use a hosted provider directly.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ── workers profile (only read when COMPOSE_PROFILES includes `workers`) ─────
# Graph worker: derived-graph retrieval. Without it, knowledge search uses
# vector + lexical retrieval only.
GRAPH_WORKER_BASE_URL=http://graph-worker:8000
GRAPH_WORKER_API_TOKEN=
GRAPH_LLM_PROVIDER=gemini
GRAPH_LLM_MODEL=gemini/gemini-2.0-flash
GRAPH_LLM_API_KEY=
# Crawl4AI: JavaScript-rendering website crawler. Without it, crawling uses
# the built-in fetch-based crawler.
CRAWL4AI_BASE_URL=http://crawl4ai:11235
CRAWL4AI_API_TOKEN=
CRAWL4AI_SECRET_KEY=
