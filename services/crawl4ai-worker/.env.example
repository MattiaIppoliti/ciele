# Crawl4AI worker secrets: copy to .env for local Docker. NEVER commit .env.
# In the managed deployment these are injected as runtime secrets (see RUNBOOK.md),
# not from a file. The worker never renders these to any client.

# Static operator token the Ciele app sends as `Authorization: Bearer <token>`.
# This is the SAME value the app sets as CRAWL4AI_API_TOKEN. Generate a strong one:
#   openssl rand -hex 32
CRAWL4AI_API_TOKEN=replace-me-with-a-32-byte-hex-token

# HS256 signing key for the server's JWT path (unused by Ciele, but validated at
# startup, a weak/short value makes the server refuse to boot). Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-32-byte-hex-secret
