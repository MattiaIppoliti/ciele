# Graph Knowledge worker secrets: copy to .env for local Docker. NEVER commit .env.
# In the managed deployment these are injected as runtime secrets (see RUNBOOK.md),
# not from a file. The worker never renders these to any client.

# Static operator token the Ciele app sends as `Authorization: Bearer <token>`.
# This is the SAME value the app sets as GRAPH_WORKER_API_TOKEN. The server
# refuses to boot if this is missing or shorter than 16 chars. Generate:
#   openssl rand -hex 32
GRAPH_WORKER_API_TOKEN=replace-me-with-a-32-byte-hex-token

# LLM provider for cognify (entity/relationship extraction) and graph-completion
# answers. Any litellm-supported provider: gemini, openai, anthropic, azure,
# ollama (local), custom (OpenAI-compatible endpoint). Embeddings stay LOCAL
# (fastembed, configured in the image), no embedding-token cost.
LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemini-2.0-flash
LLM_API_KEY=replace-me-with-your-provider-key
