[
  {
    "name": "ciele_identity",
    "description": "Who and where you are: the deployment's API version and shipped domains, plus the Organization and Role this API key acts with. Call this first to learn what you may do.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {}
    }
  },
  {
    "name": "manage_assistants",
    "description": "Ask an Assistant a question with `ask` (id + question): it answers as its published widget would, Flows and knowledge search included, and returns the answer with the Sources it cited; pass the returned conversationId to ask a follow-up. It creates a Conversation, so read-only mode refuses it; to read the knowledge without an answer use manage_knowledge `search`. Also list, read, create, update, duplicate or delete the Organization's Assistants. `list` supports limit/cursor; `update` takes a `patch` object; `delete` is permanent and needs an admin-tier key.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "export",
            "import",
            "get_access",
            "set_access",
            "clear_access",
            "ask",
            "list",
            "get",
            "create",
            "update",
            "delete",
            "duplicate"
          ]
        },
        "bundle": {
          "description": "Portable Assistant bundle (import)",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "userId": {
          "description": "Member id (access overrides)",
          "type": "string"
        },
        "role": {
          "description": "Assistant access override",
          "type": "string",
          "enum": [
            "denied",
            "viewer",
            "editor",
            "admin"
          ]
        },
        "id": {
          "description": "Assistant id (ask/get/update/delete/duplicate)",
          "type": "string"
        },
        "question": {
          "description": "What to ask the Assistant (ask)",
          "type": "string"
        },
        "conversationId": {
          "description": "A previous answer's conversationId, to continue that thread (ask)",
          "type": "string"
        },
        "title": {
          "description": "Title (create)",
          "type": "string"
        },
        "nickname": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "patch": {
          "description": "Fields to change (update)",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "limit": {
          "type": "number"
        },
        "cursor": {
          "type": "string"
        }
      },
      "required": [
        "action"
      ]
    }
  },
  {
    "name": "manage_flows",
    "description": "The Assistant's routing: list an Assistant's Flows, read one (full trigger/conditions/actions config), create, update (incl. enabled true/false), reorder, or delete. The Default behavior flow is locked and cannot be deleted. `flow` carries the FlowInput/FlowPatch body for create/update: call `catalog` FIRST to learn which triggers, actions and condition kinds exist and which pair with which, the server refuses anything outside that list rather than storing it, then `draft` (a patch) or `validate` (a whole Flow) to see what would be stored without storing it, including the human-review action the runtime inserts ahead of a Connector write. `runs` reads an HTTP-triggered Flow's recent inbound calls.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "catalog",
            "list",
            "get",
            "create",
            "draft",
            "validate",
            "runs",
            "agent_thread",
            "agent_conversation",
            "update",
            "delete",
            "reorder"
          ]
        },
        "assistantId": {
          "description": "Required for list/create/reorder",
          "type": "string"
        },
        "id": {
          "description": "Flow id (get/update/delete)",
          "type": "string"
        },
        "flow": {
          "description": "FlowInput (create) / FlowPatch (update)",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "orderedIds": {
          "description": "Full order for reorder; Default stays last",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "description": "One sentence on what the patch changes (draft)",
          "type": "string"
        },
        "rationale": {
          "description": "Why this belongs in its own Flow (validate)",
          "type": "string"
        },
        "currentTrigger": {
          "description": "The open Flow's trigger, when a draft patches only the actions",
          "type": "string"
        },
        "conversationId": {
          "description": "agent_conversation",
          "type": "string"
        },
        "limit": {
          "description": "How many runs to return (runs)",
          "type": "number"
        }
      },
      "required": [
        "action"
      ]
    }
  },
  {
    "name": "manage_knowledge",
    "description": "The Organization's knowledge. To answer a question from it, use search: it returns the passages that match the query, each with its Document, Source and URL to cite, and generates no answer (pass assistantId to search only what that Assistant answers from, omit it to search the whole Library). The rest manages it: list org-wide items (list_org_sources, filter by kinds/status/assistant), list an Assistant's Collections, list/read a Collection's Sources (poll get_source until status leaves 'processing'), add sources to a named Collection (add_text/add_url/add_file) or straight to the org Knowledge Library with no Collection id (add_org_text/add_org_url/add_org_file, which is what a newly created Assistant needs, since it has no Collection to name yet), replace a source's linked assistants (set_links), flip per-assistant direct access on a file (set_direct_access), delete a source, re-crawl a website source, add one FAQ (add_faq collection-scoped, add_org_faq org-level), bulk-import FAQs from CSV text, or export every FAQ as CSV (export_faqs). Every action that adds knowledge takes assistantIds: a Collection has no owner, so those links are the only thing that puts the knowledge in an Assistant's reach, and an empty set is refused.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "search",
            "list_collections",
            "list_sources",
            "list_org_sources",
            "get_source",
            "list_documents",
            "review_document",
            "remove_review",
            "get_faq",
            "update_faq",
            "faq_history",
            "restore_faq",
            "check_faq_duplicates",
            "source_usage",
            "add_text",
            "add_url",
            "add_file",
            "add_org_text",
            "add_org_url",
            "add_org_file",
            "set_links",
            "set_direct_access",
            "delete_source",
            "recrawl",
            "add_faq",
            "add_org_faq",
            "import_faqs",
            "import_org_faqs",
            "export_faqs"
          ]
        },
        "assistantId": {
          "description": "Required for list_collections; narrows search to that Assistant's Sources",
          "type": "string"
        },
        "collectionId": {
          "description": "Required for list_sources/add_text/add_url/add_file/add_faq/import_faqs; the add_org_* actions take none",
          "type": "string"
        },
        "documentId": {
          "type": "string"
        },
        "versionId": {
          "type": "string"
        },
        "sourceId": {
          "description": "Required for get_source/delete_source/recrawl",
          "type": "string"
        },
        "name": {
          "description": "Source name (add_text/add_org_text) / file name (add_file/add_org_file)",
          "type": "string"
        },
        "text": {
          "description": "Raw text (add_text/add_org_text)",
          "type": "string"
        },
        "url": {
          "description": "Page URL (add_url/add_org_url)",
          "type": "string"
        },
        "fileBase64": {
          "description": "File bytes, base64 (add_file/add_org_file)",
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "answer": {
          "type": "string"
        },
        "csvText": {
          "description": "CSV content (import_faqs/import_org_faqs)",
          "type": "string"
        },
        "assistantIds": {
          "description": "Linked assistants. Required by every add (add_text/add_url/add_file/add_org_text/add_org_url/add_org_file/add_faq/import_faqs/add_org_faq/import_org_faqs); for set_links it is the replacement set, where an empty array removes every link",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "directAccess": {
          "description": "set_direct_access",
          "type": "boolean"
        },
        "kinds": {
          "description": "Kind filter (list_org_sources)",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "description": "Status filter (list_org_sources)",
          "type": "string"
        },
        "q": {
          "description": "Name search (list_org_sources)",
          "type": "string"
        },
        "query": {
          "description": "The question to search the knowledge for (search)",
          "type": "string"
        }
      },
      "required": [
        "action"
      ]
    }
  },
  {
    "name": "manage_memories",
    "description": "Inspect long-term-memory settings and subjects, or perform erasure. Read actions: settings/subjects/list. Write actions: enable/disable/delete/wipe. Subject and memory access stays Organization-scoped on the server.",
