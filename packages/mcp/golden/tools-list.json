        "subjectId": {
          "type": "string"
        },
        "memoryId": {
          "type": "string"
        },
        "limit": {
          "type": "number"
        },
        "cursor": {
          "type": "string"
        }
      },
      "required": [
        "action"
      ]
    }
  },
  {
    "name": "manage_sso",
    "description": "Inspect or configure the Organization's verified SSO identity claim, the value an API Integration request can pin with {{identity.claim}}. `status` is read-only; `set_identity` sets a claim name or clears it with null. Configuration requires an admin-tier key and resets SSO validation.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "status",
            "set_identity",
            "validate",
            "connection",
            "connect",
            "disconnect"
          ]
        },
        "identityClaim": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "input": {
          "description": "Full SSO connection input for connect",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "action"
      ]
    }
  },
  {
    "name": "publish_assistant",
    "description": "Publication lifecycle (admin-tier key for writes): `status` (is it live, which version), `publish` (freeze the current config into a new immutable snapshot and serve it), `unpublish` (take the widget offline), `republish` (roll back to an earlier publicationId).",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "status",
            "publish",
            "unpublish",
            "republish"
          ]
        },
        "assistantId": {
          "type": "string"
        },
        "publicationId": {
          "description": "Required for republish",
          "type": "string"
        }
      },
      "required": [
        "action",
        "assistantId"
      ]
    }
  },
  {
    "name": "read_inbox",
    "description": "Review and curate end-user Conversations: list/get/export transcripts, pin/unpin, send conversation feedback, set message feedback, or permanently delete a conversation. Also the Human review gate's requests: list them, read one, or decide one (approve/reject; an assignee or an Owner/Admin key).",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "list",
            "get",
            "export",
            "pin",
            "unpin",
            "feedback",
            "message_feedback",
            "delete",
            "review_list",
            "review_get",
            "review_decide"
          ]
        },
        "reviewId": {
          "description": "Required for review_get and review_decide",
          "type": "string"
        },
        "status": {
          "description": "review_list: pending | approved | rejected | expired",
          "type": "string"
        },
        "decision": {
          "description": "Required for review_decide",
          "type": "string",
          "enum": [
            "approved",
            "rejected"
          ]
        },
        "inputs": {
          "description": "review_decide: the reviewer inputs by field id",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "conversationId": {
          "description": "Required for get",
          "type": "string"
        },
        "conversationIds": {
          "description": "Required for export",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "messageId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "feedback": {
          "anyOf": [
            {
              "type": "number",
              "const": -1
            },
            {
              "type": "number",
              "const": 0
            },
            {
              "type": "number",
              "const": 1
            }
          ]
        },
        "assistantId": {
          "type": "string"
        },
        "limit": {
          "type": "number"
        },
        "cursor": {
          "type": "string"
        }
      },
      "required": [
        "action"
      ]
    }
  },
  {
    "name": "manage_improvements",
    "description": "The answer-quality kanban: `list` items (filter by search, status, priority, assigneeId, assistantId or projectId; the answer carries per-status `counts` for the same filters), `get` one (with the flagged messages and any drafted fix), `update` status/priority/tags/assigneeId/projectId/dueDate/title/description via `patch`, e.g. move a card to in_progress or done. Stages: to_do is triage, in_progress fix, in_review validate, done resolved. Priority is high, medium, low or none; send \"none\" to clear it, never null.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "list",
            "get",
            "update"
          ]
        },
        "id": {
          "description": "Improvement id (get/update)",
          "type": "string"
        },
        "patch": {
          "description": "ImprovementPatch (update)",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "limit": {
          "type": "number"
        },
        "cursor": {
          "type": "string"
        },
        "search": {
          "description": "Matches title, IMP-n key or tag (list)",
          "type": "string",
          "maxLength": 300
        },
        "status": {
          "description": "One stage (list)",
          "type": "string",
          "enum": [
            "to_do",
            "in_progress",
            "in_review",
            "done",
            "archived"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "none"
          ]
        },
        "assigneeId": {
          "description": "Member id; null lists unassigned work (list)",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "assistantId": {
          "description": "Only items with evidence from this Assistant (list)",
          "type": "string"
        },
        "projectId": {
          "description": "Only items in this Project (list)",
          "type": "string"
        }
      },
      "required": [
        "action"
      ]
    }
  },
  {
    "name": "manage_teammates",
    "description": "Manage the Organization's AI Teammates: the internal agents Members chat with in the console. Delete is a soft delete, so a retired Teammate answers nothing more while its Conversations stay readable. The key acts as the Member who minted it, so `conversations` reads that Member's own thread. Use `provision` to stand one up in a single call (persona + grants + routines). A newly created Teammate can answer questions and nothing else: `set_grants` is what lets it act (improvements/knowledge/inbox; absence is refusal, there is no default) and needs an admin-tier key, and `add_routine` is what makes it run unattended (max 5 per Teammate).",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "list",
            "get",
            "create",
            "update",
            "delete",
            "conversations",
            "conversation",
            "grants",
            "set_grants",
            "routines",
            "add_routine",
            "update_routine",
            "delete_routine",
            "memory",
            "set_memory",
            "provision",
            "runtime",
            "set_runtime",
            "ag_ui"
          ]
        },
        "id": {
          "description": "Teammate id",
          "type": "string"
        },
        "conversationId": {
          "type": "string"
        },
        "routineId": {
          "description": "Routine id (update_routine/delete_routine)",
          "type": "string"
        },
        "config": {
          "description": "Execution configuration (set_runtime): harness, internet, computer; requires an admin key",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "input": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "patch": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "domains": {
          "description": "Granted domains for set_grants (the whole set, an empty array revokes everything); the domains to grant for provision",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ceiling": {
          "description": "Capability ceiling (set_grants, provision): \"member\" or \"edit\"",
          "type": "string"
        },
        "approvalBypass": {
          "description": "set_grants, provision",
          "type": "boolean"
        },
        "instruction": {
          "description": "What the Routine tells the Teammate to do",
          "type": "string"
        },
        "cadence": {
          "description": "daily | weekly | monthly",
          "type": "string"
        },
        "hour": {
          "description": "UTC hour 0-23 the Routine runs at (default 8)",
          "type": "number"
        },
        "body": {
          "description": "Whole memory document (set_memory); the previous body is kept in history",
          "type": "string"
        },
        "note": {
          "description": "Why the memory changed (set_memory)",
          "type": "string"
        }
      },
      "required": [
        "action"
      ]
    }
  },
  {
    "name": "manage_projects",
    "description": "Projects: the container of the work (its Tasks, milestones and files), the shared workspace an AI Teammate attaches to, and the owner of the Project memory layer. `set_milestones` replaces the whole list, so send back every milestone to keep with its id. `get` returns the Project with its memory document and that document's history; `set_document` replaces the body and keeps the previous one, so a revert is a restore. Delete cascades the Project's Tasks, files and decisions and detaches its Teammates: archive (`update` with `{\"archived\":true}`) is the move that keeps the record.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "list",
            "get",
            "create",
            "update",
            "delete",
            "set_document",
            "list_milestones",
            "set_milestones"
          ]
        },
        "id": {
          "description": "Project id",
          "type": "string"
        },
        "name": {
          "description": "Project name (create)",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "patch": {
          "description": "Fields to change (update)",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "body": {
          "description": "Whole document (set_document)",
          "type": "string"
        },
        "note": {
          "description": "Why it changed, shown in history",
          "type": "string"
        },
        "milestones": {
          "description": "The whole milestone list, dates YYYY-MM-DD (set_milestones)",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "date": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "date"
            ]
          }
        }
      },
      "required": [
        "action"
      ]
    }
  },
  {
    "name": "manage_tasks",
    "description": "Tasks: the work inside Projects. `list` narrows by `projectId`, `assignee` (a userId), `status` (comma-separated: backlog, to_do, in_progress, in_review, done), `label`, `dueFrom`/`dueTo` (YYYY-MM-DD), `q` (text) and `improvementId`, and pages with `cursor`. `update` takes `patch` with any of title, description, status, priority (urgent/high/medium/low/none), assigneeMemberId, startDate, dueDate (YYYY-MM-DD), plus `labelIds` and `blockedBy` to replace those lists, `position` ({afterId, beforeId}) to reorder, `projectId` to move it, and `archived` to archive or restore it. `comment` posts as the key's Member; mention someone as @[Name](member:<userId>). `delete` takes the task's subtasks, comments and files with it. `labels` lists the Labels; `set_label` creates one (no `id`), changes one (`id`), or deletes one (`id` and `delete: true`).",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "list",
            "get",
            "create",
            "update",
            "delete",
            "list_comments",
            "comment",
            "labels",
            "set_label"
          ]
        },
        "id": {
          "description": "Task id, or Label id for set_label",
          "type": "string"
        },
        "projectId": {
          "description": "Project id (list, create; update moves the task)",
          "type": "string"
        },
        "assignee": {
          "description": "Assignee userId (list)",
          "type": "string"
        },
        "status": {
          "description": "Comma-separated statuses (list)",
          "type": "string"
        },
        "label": {
          "description": "Label id (list)",
          "type": "string"
        },
        "dueFrom": {
          "description": "YYYY-MM-DD (list)",
          "type": "string"
        },
        "dueTo": {
          "description": "YYYY-MM-DD (list)",
          "type": "string"
        },
        "q": {
          "description": "Text in the title or description (list)",
          "type": "string"
        },
        "improvementId": {
          "description": "Tasks resolving this Improvement (list)",
          "type": "string"
        },
        "cursor": {
