#!/bin/sh
# Pre-push gate: everything CI's `verify` job runs, locally.
#
# It exists because GitHub Actions is not reliably available on this repo (a $0
# spending limit refuses jobs outright, see CLAUDE.md), so "CI will catch it" is
# not a thing you can lean on. Turbo caches, so an unchanged tree costs seconds;
# the slow runs are the ones that changed a lot, which is when you want it.
#
# `pnpm install` enables it (the root `prepare` script sets core.hooksPath);
# by hand it is:
#
#   git config core.hooksPath .githooks
#
# Bypass a single push with `git push --no-verify`.
set -e

# Validation creates temporary repositories. Keep Git's hook-local paths out
# of those commands so they cannot modify this repository instead.
for task_git_env in $(git rev-parse --local-env-vars); do
  unset "$task_git_env"
done

# Install first, exactly as CI does. Without this the gate is actively
# misleading: rebase onto a commit that moved the dependency graph, and every
# workspace fails against the node_modules you already had. `--frozen-lockfile`
# also makes a package.json edited without its lockfile a push-time error
# instead of a CI-time one.
pnpm install --frozen-lockfile

pnpm verify

# The CI jobs that need Docker (self-host, migration replays, the web image),
# from the real workflow files, only for what this branch changed. Skipped with
# a notice when Docker or act is missing, so a machine without them can still
# push; CI remains the net there.
if command -v act >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  exec pnpm verify:docker --changed
fi
echo "pre-push: no Docker daemon or act here, the Docker CI jobs were not run locally."
