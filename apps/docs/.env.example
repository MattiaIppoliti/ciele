# The docs "Ask AI" launcher embeds the published Ciele assistant's own chat
# panel (as an iframe). These override the baked-in production defaults; leave
# them blank to use https://ciele.app with the default assistant.
NEXT_PUBLIC_CIELE_WIDGET_ORIGIN=
NEXT_PUBLIC_CIELE_ASSISTANT_ID=

# Repository this deployment's docs link to: the sidebar GitHub button and the
# per-page "Edit this page" action. No default, a fork sets its own slug, and
# blank simply omits both links. Point it at the repo root, e.g.
# https://github.com/<owner>/<repo>.
NEXT_PUBLIC_DOCS_REPO_URL=

# Site the sidebar's home button returns to. Blank uses https://ciele.app.
NEXT_PUBLIC_CIELE_SITE_URL=

# Lara Translate access key for `pnpm translate:docs`, which regenerates the
# it/es/fr/de pages from the English source. Needed only to run that script:
# the site builds from the committed translations with no key and no network.
# Put the real values in .env.local (gitignored) or export them. Never here.
LARA_ACCESS_KEY_ID=
LARA_ACCESS_KEY_SECRET=
