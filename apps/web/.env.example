# apps/web environment, copy to `apps/web/.env.local` and fill in.
#
#   cp apps/web/.env.example apps/web/.env.local
#
# The values below are the defaults for a LOCAL Supabase stack
# (`pnpm db:start` from the repo root), which makes the demo run on the same
# Postgres + Auth + RLS stack as production. Leave the Supabase vars blank to
# fall back to the in-memory mock store (zero-setup demo, no database).

# ── Supabase ────────────────────────────────────────────────────────────────
# When BOTH URL and ANON_KEY are set, the data layer switches from the mock
# store to Supabase automatically (see packages/db `isSupabaseConfigured`).
# These are the well-known local-dev credentials the Supabase CLI serves on
# every machine, safe to commit because they only work against 127.0.0.1.
# Run `pnpm db:status` to confirm the exact values your CLI printed.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE

# Server-only. Bypasses RLS for the widget runtime and platform reads. In a
# real deployment get it from Supabase dashboard > Project Settings > API >
# service_role. Never expose to the browser. Local-dev default below.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxNzk5NTM1NjAwfQ.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ── AI provider ───────────────────────────────────────────────────────────────
# Platform key the chat runtime uses when an assistant has no BYOK connection.
# With this set, demo assistants (configured for google/gemini-3.1-flash-lite)
# answer through a real LLM instead of the deterministic keyword engine.
# Get one at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: the other platform providers.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: OpenAI-compatible endpoint fallback (#436), any server speaking
# the OpenAI chat/embeddings API (Ollama, vLLM, LM Studio, a gateway). Used
# when an organization has no OpenAI-compatible Provider Connection, so a
# self-host runs fully local with zero in-app configuration. BASE_URL and
# CHAT_MODEL are both required for the fallback to activate; the API key is
# only needed if the server enforces auth. EMBEDDING_MODEL enables semantic
# knowledge search (otherwise lexical only); EMBEDDING_DIMS records the
# model's native vector dimension (e.g. 768 for nomic-embed-text).
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_CHAT_MODEL=llama3.1:8b
# OPENAI_COMPATIBLE_EMBEDDING_MODEL=nomic-embed-text
# OPENAI_COMPATIBLE_EMBEDDING_DIMS=768

# Real ChatGPT/Claude subscription sign-in through the installed Codex and
# Claude Code CLIs. ON BY DEFAULT on any loopback host outside production,
# whoever ran `codex login` / `claude auth login --claudeai` in their terminal
# gets that sign-in in Preview, with no flag to set. Hard-disabled in
# production. Works with either data layer: the in-memory demo db or a
# locally-run Supabase-backed instance with real Organization members.
# Set to 0/false/off to opt a local instance back out (reproduce hosted
# behaviour, where a machine CLI identity must never answer).
# ENABLE_LOCAL_SUBSCRIPTION_TEST=0
# CODEX_CLI_PATH=/absolute/path/to/codex
# CLAUDE_CLI_PATH=/absolute/path/to/claude
# The Ciele Connector does not require these variables: it finds the CLIs
# locally, pairs with the browser through authenticated loopback, and claims
# only that Member's Preview inference jobs through Ciele APIs. Members connect
# it with the "Authorize from Terminal" one-liner (served by the runtime route).

# ── Secrets & ops ─────────────────────────────────────────────────────────────
# Seals BYOK provider API keys at rest (AES-256-GCM). Any string; without it,
# keys are stored as marked plaintext with a warning. Generate one with:
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Shared secret guarding the cron/maintenance API routes. Any string.
# CRON_SECRET=

# First user with this email becomes the platform owner on signup.
# PLATFORM_OWNER_EMAIL=

# Outbound email (Resend). Both must be set or every send, invitations,
# Improvement notifications, escalation email, contact-sales enquiries,
# reports "not configured" instead of delivering.
# RESEND_API_KEY=
# EMAIL_FROM=

# The Resend Audience the footer newsletter form subscribes confirmed addresses
# to. Unset means the confirm page tells the visitor it could not complete the
# sign-up rather than thanking them for nothing. Create it in the Resend
# dashboard (Audiences) and paste its id. The confirmation link is signed with
# APP_ENCRYPTION_KEY, so that must be set too or the form reports unavailable.
# RESEND_AUDIENCE_ID=

# Where the public /contact/sales form delivers. Unset means the marketing
# site's only inbound sales path tells visitors it could not send, so set it
# in any environment where that form is reachable.
# CONTACT_SALES_EMAIL=sales@example.com

# Optional: Apify token for the website-crawl knowledge ingestion pipeline.
# APIFY_API_TOKEN=

# Optional: private Crawl4AI worker for the website-crawl pipeline. Both must be
# set for Crawl4AI to be selectable; the token is server-only (never reaches the
# browser). The worker is a pinned, authenticated container (packaged separately).
# CRAWL4AI_BASE_URL=
# CRAWL4AI_API_TOKEN=
